# Skopiuj do `.env`. Baza deweloperska z `compose.yaml` albo z lokalnego klastra
# uruchamianego przez hook sesji chmurowej (oba używają tych danych).
DATABASE_URL=postgres://byw:byw@localhost:5432/byw_dev

# Wersja prywatna (prawdziwe dane) ma osobny plik `.env.private`
# (wzór: `.env.private.example`), czytany tylko przez `npm run private:*`.
#
# Demo (Vercel + Neon) nie korzysta z tych plików — zmienne ustawia się
# w Vercel w zakresie „Production”. Szczegóły i kroki: AGENTS.md
# („Wersja demo”). W skrócie:
#   DATABASE_URL           = adres z poolerem (runtime aplikacji),
#   DATABASE_URL_UNPOOLED  = adres bezpośredni (migracje w buildzie),
#   APP_MODE               = demo.

# Lokalne testowanie wersji demo (przycisk „Wypróbuj wersję demo"
# z piaskownicą). Domyślnie `npm run dev` działa w trybie prywatnym
# (logowanie hasłem). Aby zamiast tego uruchomić demo na `byw_dev`,
# odkomentuj obie zmienne i zrestartuj `npm run dev`. DEMO_IP_SECRET to
# dowolny lokalny ciąg — służy tylko do skrótu adresu IP przy limitach.
# APP_MODE=demo
# DEMO_IP_SECRET=lokalny-sekret-demo
