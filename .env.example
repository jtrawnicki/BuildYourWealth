# Skopiuj do `.env`. Baza deweloperska z `compose.yaml` albo z lokalnego klastra
# uruchamianego przez hook sesji chmurowej (oba używają tych danych).
DATABASE_URL=postgres://byw:byw@localhost:5432/byw_dev

# Produkcja (Vercel + Neon) nie korzysta z tego pliku — zmienne ustawia się
# w Vercel w zakresie „Production”. Szczegóły i dokładne kroki: AGENTS.md
# („Wdrożenie produkcyjne”). W skrócie:
#   DATABASE_URL           = adres z poolerem (runtime aplikacji),
#   DATABASE_URL_UNPOOLED  = adres bezpośredni (migracje w buildzie).
